FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
# Keep security packages current and replace the old Go-built privilege helper.
# The upstream entrypoint only needs USER COMMAND privilege switching.
RUN apk upgrade --no-cache && apk add --no-cache su-exec && rm /usr/local/bin/gosu && sed -i 's/exec gosu postgres/exec su-exec postgres/' /usr/local/bin/docker-entrypoint.sh
