# Replace every placeholder before starting. Do not commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_MIGRATION_PASSWORD
AUTH_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_RUNTIME_PASSWORD
DATABASE_URL=postgres://auth_runtime:REPLACE_WITH_RUNTIME_PASSWORD@localhost:5432/auth?sslmode=disable
PUBLIC_URL=http://localhost:8081
# Production HTTPS overlay: hostname only, for example auth.your-company.com.
AUTH_DOMAIN=
LISTEN_ADDR=127.0.0.1:8081
AUTH_ACTIVE_KEY=v1
AUTH_ENCRYPTION_KEYS=v1:REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
REGISTRATION_MODE=invite
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=auth@example.com
# Optional private CA bundle for SMTP STARTTLS:
SMTP_CA_FILE=
# Empty by default; only list proxy networks you control.
TRUSTED_PROXIES=
BOOTSTRAP_TENANT=my-workspace
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_NAME=Workspace Owner
